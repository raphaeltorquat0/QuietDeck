   "nds"
  ],
  "launch": "run net.kuribo64.melonDS -f {rom}"
 },
 {
  "id": "mgba",
  "name": "mGBA",
  "flatpak": "io.mgba.mGBA",
  "systems": [
   "gba"
  ],
  "launch": "run io.mgba.mGBA -f {rom}"
 },
 {
  "id": "flycast",
  "name": "Flycast",
  "flatpak": "org.flycast.Flycast",
  "systems": [
   "dreamcast"
  ],
  "launch": "run org.flycast.Flycast {rom}"
 },
 {
  "id": "scummvm",
  "name": "ScummVM",
  "flatpak": "org.scummvm.ScummVM",
  "systems": [
   "scummvm"
  ],
  "launch": "run org.scummvm.ScummVM -f {rom}"
 }
]
