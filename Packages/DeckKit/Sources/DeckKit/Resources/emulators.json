 },
 {
  "id": "rpcs3",
  "name": "RPCS3",
  "flatpak": "net.rpcs3.RPCS3",
  "systems": [
   "ps3"
  ],
  "launch": "run net.rpcs3.RPCS3 --no-gui --fullscreen {rom}",
  "profiles": [
   {
    "path": ".var/app/net.rpcs3.RPCS3/config/rpcs3/input_configs/global/Default.yml",
    "format": "yaml",
    "entries": [],
    "create": "Player 1 Input:\n  Handler: SDL\n  Device: Steam Deck Controller 1\n"
   },
   {
    "path": ".var/app/net.rpcs3.RPCS3/config/rpcs3/config.yml",
    "format": "yaml",
    "untouched": "Shader Mode: Async Recompiler with Shader Interpreter",
    "entries": [
     {
      "key": "Shader Mode",
      "value": "Async Recompiler (multi-threaded)"
     }
    ]
   }
  ]
 },
 {
  "id": "shadps4",
  "name": "shadPS4",
  "flatpak": "net.shadps4.shadPS4",
  "systems": [
   "ps4"
  ],
  "launch": "run --command=shadps4 net.shadps4.shadPS4 -f true -g {rom}"
 },
