[
 {
  "id": "retroarch",
  "name": "RetroArch",
  "flatpak": "org.libretro.RetroArch",
  "systems": [
   "many"
  ],
  "launch": "run org.libretro.RetroArch -f -L {core} {rom}",
  "config": {
   "path": ".var/app/org.libretro.RetroArch/config/retroarch/retroarch.cfg",
   "format": "cfg",
   "entries": [
    {
     "key": "system_directory",
     "value": "{bios}"
    },
    {
     "key": "rgui_browser_directory",
     "value": "{roms}"
    },
    {
     "key": "savefile_directory",
     "value": "{saves}/retroarch/saves"
    },
    {
     "key": "savestate_directory",
     "value": "{saves}/retroarch/states"
    }
   ]
  },
  "saves": [
   ".var/app/org.libretro.RetroArch/config/retroarch/saves",
   ".var/app/org.libretro.RetroArch/config/retroarch/states"
  ]
 },
 {
  "id": "dolphin",
  "name": "Dolphin",
  "flatpak": "org.DolphinEmu.dolphin-emu",
  "systems": [
   "gc",
   "wii"
  ],
  "launch": "run org.DolphinEmu.dolphin-emu -b -e {rom}",
  "config": {
   "path": ".var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu/Dolphin.ini",
   "format": "ini",
   "entries": [
    {
     "section": "General",
     "key": "ISOPaths",
     "value": "2"
    },
    {
     "section": "General",
     "key": "ISOPath0",
     "value": "{roms}/gc"
    },
    {
     "section": "General",
     "key": "ISOPath1",
     "value": "{roms}/wii"
    }
   ]
  },
  "saves": [
   ".var/app/org.DolphinEmu.dolphin-emu/data/dolphin-emu/GC",
   ".var/app/org.DolphinEmu.dolphin-emu/data/dolphin-emu/Wii"
  ],
  "profiles": [
   {
    "path": ".var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu/GCPadNew.ini",
    "format": "ini",
    "untouched": "[GCPad1]\nDevice = XInput2/0/Virtual core pointer",
    "entries": [
     {
      "section": "GCPad1",
      "key": "Device",
      "value": "SDL/0/Steam Deck Controller"
     },
     {
      "section": "GCPad1",
      "key": "Buttons/A",
      "value": "`Button S`"
     },
     {
      "section": "GCPad1",
      "key": "Buttons/B",
      "value": "`Button E`"
     },
     {
      "section": "GCPad1",
      "key": "Buttons/X",
      "value": "`Button W`"
     },
     {
      "section": "GCPad1",
      "key": "Buttons/Y",
      "value": "`Button N`"
     },
     {
      "section": "GCPad1",
      "key": "Buttons/Z",
      "value": "`Shoulder R`"
     },
     {
      "section": "GCPad1",
      "key": "Buttons/Start",
      "value": "`Start`"
     },
     {
      "section": "GCPad1",
      "key": "Main Stick/Up",
      "value": "`Left Y+`"
     },
     {
      "section": "GCPad1",
      "key": "Main Stick/Down",
      "value": "`Left Y-`"
     },
     {
      "section": "GCPad1",
      "key": "Main Stick/Left",
      "value": "`Left X-`"
     },
     {
      "section": "GCPad1",
      "key": "Main Stick/Right",
      "value": "`Left X+`"
     },
     {
      "section": "GCPad1",
      "key": "C-Stick/Up",
      "value": "`Right Y+`"
     },
     {
      "section": "GCPad1",
      "key": "C-Stick/Down",
      "value": "`Right Y-`"
     },
     {
      "section": "GCPad1",
      "key": "C-Stick/Left",
      "value": "`Right X-`"
     },
     {
      "section": "GCPad1",
      "key": "C-Stick/Right",
      "value": "`Right X+`"
     },
     {
      "section": "GCPad1",
      "key": "Triggers/L",
      "value": "`Trigger L`"
     },
     {
      "section": "GCPad1",
      "key": "Triggers/R",
      "value": "`Trigger R`"
     },
     {
      "section": "GCPad1",
      "key": "Triggers/L-Analog",
      "value": "`Trigger L`"
     },
     {
      "section": "GCPad1",
      "key": "Triggers/R-Analog",
      "value": "`Trigger R`"
     },
     {
      "section": "GCPad1",
      "key": "D-Pad/Up",
      "value": "`Pad N`"
     },
     {
      "section": "GCPad1",
      "key": "D-Pad/Down",
      "value": "`Pad S`"
     },
     {
      "section": "GCPad1",
      "key": "D-Pad/Left",
      "value": "`Pad W`"
     },
     {
      "section": "GCPad1",
      "key": "D-Pad/Right",
      "value": "`Pad E`"
     },
     {
      "section": "GCPad1",
      "key": "Rumble/Motor",
      "value": "`Motor L`|`Motor R`"
     }
    ]
   },
   {
    "path": ".var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu/GFX.ini",
    "format": "ini",
    "onlyMissing": true,
    "entries": [
     {
      "section": "Settings",
      "key": "InternalResolution",
      "value": "2"
     },
     {
      "section": "Settings",
      "key": "wideScreenHack",
      "value": "True"
     },
     {
      "section": "Settings",
      "key": "AspectRatio",
      "value": "3"
     }
    ]
   },
   {
    "path": ".var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu/Dolphin.ini",
    "format": "ini",
    "onlyMissing": true,
    "entries": [
     {
      "section": "Display",
      "key": "Fullscreen",
      "value": "True"
     }
    ]
   }
  ]
 },
 {
  "id": "pcsx2",
  "name": "PCSX2",
  "flatpak": "net.pcsx2.PCSX2",
  "systems": [
   "ps2"
  ],
  "launch": "run net.pcsx2.PCSX2 -batch -fullscreen {rom}",
  "config": {
   "path": ".var/app/net.pcsx2.PCSX2/config/PCSX2/inis/PCSX2.ini",
   "format": "ini",
   "entries": [
    {
     "section": "Folders",
     "key": "Bios",
     "value": "{bios}"
    },
    {
     "section": "GameList",
     "key": "RecursivePaths",
     "value": "{roms}/ps2"
    }
   ]
  },
  "saves": [
   ".var/app/net.pcsx2.PCSX2/config/PCSX2/memcards",
   ".var/app/net.pcsx2.PCSX2/config/PCSX2/sstates"
  ]
 },
 {
  "id": "ppsspp",
  "name": "PPSSPP",
  "flatpak": "org.ppsspp.PPSSPP",
  "systems": [
   "psp"
  ],
  "launch": "run org.ppsspp.PPSSPP --fullscreen {rom}",
  "config": {
   "path": ".var/app/org.ppsspp.PPSSPP/config/ppsspp/PSP/SYSTEM/ppsspp.ini",
   "format": "ini",
   "entries": [
    {
     "section": "General",
     "key": "CurrentDirectory",
     "value": "{roms}/psp"
    }
   ]
  },
  "saves": [
   ".var/app/org.ppsspp.PPSSPP/config/ppsspp/PSP/SAVEDATA",
   ".var/app/org.ppsspp.PPSSPP/config/ppsspp/PSP/PPSSPP_STATE"
  ]
 },
 {
  "id": "duckstation",
  "name": "DuckStation",
  "flatpak": "org.duckstation.DuckStation",
  "systems": [
   "psx"
  ],
  "available": false,
  "note": "Removed from Flathub (end of life). PlayStation games use the SwanStation core in RetroArch."
 },
 {
  "id": "cemu",
  "name": "Cemu",
  "flatpak": "info.cemu.Cemu",
  "systems": [
   "wiiu"
  ],
  "launch": "run info.cemu.Cemu -f -g {rom}",
  "note": "Set the game path inside Cemu: QuietDeck doesn't write its config because the Flatpak path isn't documented."
 },
 {
  "id": "xemu",
  "name": "xemu",
  "flatpak": "app.xemu.xemu",
  "systems": [
   "xbox"
  ],
  "launch": "run app.xemu.xemu -full-screen -dvd_path {rom}",
  "config": {
   "path": ".var/app/app.xemu.xemu/data/xemu/xemu/xemu.toml",
   "format": "toml",
   "entries": [
    {
     "section": "sys.files",
     "key": "bootrom_path",
     "value": "{bios}/mcpx_1.0.bin"
    },
    {
     "section": "sys.files",
     "key": "flashrom_path",
     "value": "{bios}/Complex_4627.bin"
    },
    {
     "section": "sys.files",
     "key": "eeprom_path",
     "value": "{storage}/xemu/eeprom.bin"
    },
    {
     "section": "sys.files",
     "key": "hdd_path",
     "value": "{storage}/xemu/xbox_hdd.qcow2"
    }
   ]
  }
 },
 {
  "id": "primehack",
  "name": "PrimeHack",
  "flatpak": "io.github.shiiion.primehack",
  "systems": [
   "gc",
   "wii"
  ],
  "launch": "run io.github.shiiion.primehack -b -e {rom}"
 },
 {
  "id": "rpcs3",
  "name": "RPCS3",
  "flatpak": "net.rpcs3.RPCS3",
  "systems": [
   "ps3"
  ],
  "launch": "run net.rpcs3.RPCS3 --no-gui {rom}"
 },
 {
  "id": "shadps4",
  "name": "shadPS4",
  "flatpak": "net.shadps4.shadPS4",
  "systems": [
   "ps4"
  ],
  "launch": "run --command=shadps4 net.shadps4.shadPS4 -f true -g {rom}"
 },
 {
  "id": "ryubing",
  "name": "Ryubing (Ryujinx)",
  "flatpak": "io.github.ryubing.Ryujinx",
  "systems": [
   "switch"
  ],
  "launch": "run io.github.ryubing.Ryujinx {rom}",
  "profiles": [
   {
    "path": ".var/app/io.github.ryubing.Ryujinx/config/Ryujinx/Config.json",
    "format": "json",
    "untouched": "input_config.0.backend=WindowKeyboard",
    "entries": [
     {
      "key": "input_config",
      "value": "[{\"left_joycon_stick\":{\"joystick\":\"Left\",\"invert_stick_x\":false,\"invert_stick_y\":false,\"rotate90_cw\":false,\"stick_button\":\"LeftStick\"},\"right_joycon_stick\":{\"joystick\":\"Right\",\"invert_stick_x\":false,\"invert_stick_y\":false,\"rotate90_cw\":false,\"stick_button\":\"RightStick\"},\"deadzone_left\":0.1,\"deadzone_right\":0.1,\"range_left\":1.0,\"range_right\":1.0,\"trigger_threshold\":0.5,\"motion\":{\"motion_backend\":\"GamepadDriver\",\"sensitivity\":100,\"gyro_deadzone\":1,\"enable_motion\":true},\"rumble\":{\"strong_rumble\":1.0,\"weak_rumble\":1.0,\"enable_rumble\":true},\"left_joycon\":{\"button_minus\":\"Minus\",\"button_l\":\"LeftShoulder\",\"button_zl\":\"LeftTrigger\",\"button_sl\":\"Unbound\",\"button_sr\":\"Unbound\",\"dpad_up\":\"DpadUp\",\"dpad_down\":\"DpadDown\",\"dpad_left\":\"DpadLeft\",\"dpad_right\":\"DpadRight\"},\"right_joycon\":{\"button_plus\":\"Plus\",\"button_r\":\"RightShoulder\",\"button_zr\":\"RightTrigger\",\"button_sl\":\"Unbound\",\"button_sr\":\"Unbound\",\"button_x\":\"Y\",\"button_b\":\"A\",\"button_y\":\"X\",\"button_a\":\"B\"},\"version\":1,\"backend\":\"GamepadSDL2\",\"id\":\"0-00000003-28de-0000-ff11-000001000000\",\"name\":\"Steam Virtual Gamepad\",\"controller_type\":\"ProController\",\"player_index\":\"Player1\"}]"
     }
    ]
   },
   {
    "path": ".var/app/io.github.ryubing.Ryujinx/config/Ryujinx/Config.json",
    "format": "json",
    "untouched": "start_fullscreen=false",
    "entries": [
     {
      "key": "start_fullscreen",
      "value": "true"
     },
     {
      "key": "docked_mode",
      "value": "false"
     },
     {
      "key": "show_confirm_exit",
      "value": "false"
     },
     {
      "key": "show_console",
      "value": "false"
     }
    ]
   }
  ]
 },
 {
  "id": "azahar",
  "name": "Azahar",
  "flatpak": "org.azahar_emu.Azahar",
  "systems": [
   "n3ds"
  ],
  "launch": "run org.azahar_emu.Azahar -f {rom}"
 },
 {
