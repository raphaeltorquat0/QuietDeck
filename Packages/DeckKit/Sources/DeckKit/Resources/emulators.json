 {
  "id": "pcsx2",
  "name": "PCSX2",
  "flatpak": "net.pcsx2.PCSX2",
  "systems": [
   "ps2"
  ],
  "launch": "run net.pcsx2.PCSX2 -batch -fullscreen {rom}",
  "config": {
   "path": ".var/app/net.pcsx2.PCSX2/config/PCSX2/inis/PCSX2.ini",
   "format": "ini",
   "entries": [
    {
     "section": "Folders",
     "key": "Bios",
     "value": "{bios}"
    },
    {
     "section": "GameList",
     "key": "RecursivePaths",
     "value": "{roms}/ps2"
    }
   ]
  },
  "saves": [
   ".var/app/net.pcsx2.PCSX2/config/PCSX2/memcards",
   ".var/app/net.pcsx2.PCSX2/config/PCSX2/sstates"
  ]
 },
 {
  "id": "ppsspp",
  "name": "PPSSPP",
  "flatpak": "org.ppsspp.PPSSPP",
  "systems": [
   "psp"
  ],
  "launch": "run org.ppsspp.PPSSPP --fullscreen {rom}",
  "config": {
   "path": ".var/app/org.ppsspp.PPSSPP/config/ppsspp/PSP/SYSTEM/ppsspp.ini",
   "format": "ini",
   "entries": [
    {
     "section": "General",
     "key": "CurrentDirectory",
     "value": "{roms}/psp"
    }
   ]
  },
  "saves": [
   ".var/app/org.ppsspp.PPSSPP/config/ppsspp/PSP/SAVEDATA",
   ".var/app/org.ppsspp.PPSSPP/config/ppsspp/PSP/PPSSPP_STATE"
  ]
 },
 {
  "id": "duckstation",
  "name": "DuckStation",
  "flatpak": "org.duckstation.DuckStation",
  "systems": [
   "psx"
  ],
  "available": false,
  "note": "Removed from Flathub (end of life). PlayStation games use the SwanStation core in RetroArch."
 },
 {
  "id": "cemu",
  "name": "Cemu",
  "flatpak": "info.cemu.Cemu",
  "systems": [
   "wiiu"
  ],
  "launch": "run info.cemu.Cemu -f -g {rom}",
  "note": "Set the game path inside Cemu: QuietDeck doesn't write its config because the Flatpak path isn't documented."
 },
 {
  "id": "xemu",
  "name": "xemu",
  "flatpak": "app.xemu.xemu",
  "systems": [
   "xbox"
  ],
  "launch": "run app.xemu.xemu -full-screen -dvd_path {rom}",
  "config": {
   "path": ".var/app/app.xemu.xemu/data/xemu/xemu/xemu.toml",
   "format": "toml",
   "entries": [
    {
     "section": "sys.files",
     "key": "bootrom_path",
     "value": "{bios}/mcpx_1.0.bin"
    },
    {
     "section": "sys.files",
     "key": "flashrom_path",
     "value": "{bios}/Complex_4627.bin"
    },
    {
     "section": "sys.files",
     "key": "eeprom_path",
     "value": "{storage}/xemu/eeprom.bin"
    },
    {
     "section": "sys.files",
     "key": "hdd_path",
     "value": "{storage}/xemu/xbox_hdd.qcow2"
    }
   ]
  }
 },
 {
  "id": "primehack",
  "name": "PrimeHack",
  "flatpak": "io.github.shiiion.primehack",
  "systems": [
   "gc",
   "wii"
  ],
