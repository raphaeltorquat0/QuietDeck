  "profiles": [
   {
    "path": ".local/share/quietdeck/emulators/lichii/user/config/qt-config.ini",
    "format": "qt",
    "untouched": "player_0_button_a=\"engine:keyboard,code:67,toggle:0\"",
    "entries": [
