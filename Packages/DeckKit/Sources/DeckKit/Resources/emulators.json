[
 {
  "id": "retroarch",
  "name": "RetroArch",
  "flatpak": "org.libretro.RetroArch",
  "systems": [
   "many"
  ],
  "launch": "run org.libretro.RetroArch -f -L {core} {rom}",
  "config": {
   "path": ".var/app/org.libretro.RetroArch/config/retroarch/retroarch.cfg",
   "format": "cfg",
   "entries": [
    {
     "key": "system_directory",
     "value": "{bios}"
    },
    {
     "key": "rgui_browser_directory",
     "value": "{roms}"
    },
    {
     "key": "savefile_directory",
     "value": "{saves}/retroarch/saves"
    },
    {
     "key": "savestate_directory",
     "value": "{saves}/retroarch/states"
    }
   ]
  },
  "saves": [
   ".var/app/org.libretro.RetroArch/config/retroarch/saves",
   ".var/app/org.libretro.RetroArch/config/retroarch/states"
  ],
  "profiles": [
   {
    "path": ".var/app/org.libretro.RetroArch/config/retroarch/retroarch.cfg",
    "format": "cfg",
    "untouched": "input_menu_toggle_gamepad_combo = \"0\"",
    "entries": [
     {
      "key": "input_menu_toggle_gamepad_combo",
      "value": "2"
     }
    ]
   }
  ]
 },
 {
  "id": "dolphin",
