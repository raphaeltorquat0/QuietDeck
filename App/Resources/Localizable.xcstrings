   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Obtenha uma chave em steamgriddb.com"
     }
    }
   }
  },
  "Go to Settings › Developer › **Pair new host**. This screen moves on by itself.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Vá em Configurações › Desenvolvedor › **Parear novo host**. Esta tela avança sozinha."
     }
    }
   }
  },
  "Hold the Power button, choose **Switch to Desktop** and open **Konsole**. Then run:": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Segure o botão Power, escolha **Mudar para o Desktop** e abra o **Konsole**. Depois rode:"
     }
    }
   }
  },
  "Host": {
   "localizations": {
    "pt-BR": {
