  "Add to Steam…": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicionar ao Steam…"
     }
    }
   }
  },
  "Add your SteamGridDB API key in Settings to choose artwork.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicione sua chave de API do SteamGridDB em Ajustes para escolher artes."
