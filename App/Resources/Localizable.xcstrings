  "Copies Emulation/saves and each emulator's save folders to this Mac. Nothing on the Deck is deleted.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Copia Emulation/saves e as pastas de saves de cada emulador para este Mac. Nada é apagado no Deck."
     }
    }
   }
  },
  "Copy": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Copiar"
     }
    }
   }
  },
  "Couldn't reach the Deck. Check that it's awake and on this network. %@": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Não foi possível falar com o Deck. Confira se ele está ligado e nesta rede. %@"
