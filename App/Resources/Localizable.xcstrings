{
 "sourceLanguage": "en",
 "strings": {
  "%@ already exists.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ já existe."
     }
    }
   }
  },
  "%@ answered %@. Check the API key in Settings.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ respondeu %@. Confira a chave de API em Ajustes."
     }
    }
   }
  },
  "%@ doesn't look like Switch firmware: it has %@ .nca files.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não parece firmware do Switch: tem %@ arquivos .nca."
     }
    }
   }
  },
  "%@ doesn't match any known BIOS hash, so it wasn't copied.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não confere com nenhum hash de BIOS conhecido, então não foi copiado."
     }
    }
   }
  },
  "%@ doesn't match the catalog checksum, so it wasn't installed.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não confere com o hash do catálogo, então não foi instalado."
     }
    }
   }
  },
  "%@ files fit more than one system.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ arquivos servem em mais de um sistema."
     }
    }
   }
  },
  "%@ files fit more than one system. Move them into a system folder.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ arquivos servem em mais de um sistema. Mova-os para uma pasta de sistema."
     }
    }
   }
  },
  "%@ free": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ livres"
     }
    }
   }
  },
  "%@ free on %@": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ livres em %@"
     }
    }
   }
  },
  "%@ has no romfs or exefs folder under a Switch title ID.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não tem pasta romfs ou exefs dentro de um Title ID do Switch."
     }
    }
   }
  },
  "%@ is damaged or isn't a patch QuietDeck can apply.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ está danificado ou não é um patch que o QuietDeck sabe aplicar."
     }
    }
   }
  },
  "%@ is missing and Homebrew isn't installed. Install Homebrew from brew.sh, then try again.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não foi encontrado, e o Homebrew não está instalado. Instale o Homebrew em brew.sh e tente de novo."
     }
    }
   }
  },
  "%@ isn't a Switch keys file.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não é um arquivo de chaves do Switch."
     }
    }
   }
  },
  "%@ isn't an extracted %@ game. Drop the game folder (CUSA…, with eboot.bin and sce_sys) instead of the .pkg.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não é um jogo de %@ extraído. Solte a pasta do jogo (CUSA…, com eboot.bin e sce_sys) em vez do .pkg."
     }
    }
   }
  },
  "%@ isn't available.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não está disponível."
     }
    }
   }
  },
  "%@ isn't in a ROM folder, so it wasn't deleted.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não está numa pasta de ROMs, então não foi apagado."
     }
    }
   }
  },
  "%@ isn't there anymore. Check that the network share is mounted.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não está mais lá. Confira se o compartilhamento de rede está montado."
     }
    }
   }
  },
  "%@ quota reached. Try again later.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Cota de %@ atingida. Tente mais tarde."
     }
    }
   }
  },
  "%@ refused your credentials.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ recusou suas credenciais."
     }
    }
   }
  },
  "%@ was made for another version of this game. Check the CRC32 or SHA-1 its readme asks for.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ foi feito para outra versão deste jogo. Confira o CRC32 ou SHA-1 pedido no leia-me do patch."
     }
    }
   }
  },
  "%lld files fit more than one system.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%lld arquivos servem em mais de um sistema."
     }
    }
   }
  },
  "%lld updates": {
   "localizations": {
    "en": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld update"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld updates"
        }
       }
      }
     }
    },
    "pt-BR": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld atualização"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld atualizações"
        }
       }
      }
     }
    }
   }
  },
  "A": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "A"
     }
    }
   }
  },
  "A config file already exists. Only the ROM, BIOS and save paths change, and a backup is kept next to it.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Já existe um arquivo de configuração. Só os caminhos de ROM, BIOS e saves mudam, e um backup fica ao lado dele."
     }
    }
   }
  },
  "A folder on this Mac or a mounted SMB or NFS share, laid out as collection/system/files.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma pasta neste Mac ou um compartilhamento SMB ou NFS montado, no formato acervo/sistema/arquivos."
     }
    }
   }
  },
  "A pairing request from this Mac is on the Deck's screen. Choose **Approve**.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Há um pedido de pareamento deste Mac na tela do Deck. Escolha **Aprovar**."
     }
    }
   }
  },
  "A patch can't be applied to %@. Use the original .bin, .iso or .cue instead.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Não dá para aplicar um patch em %@. Use o .bin, .iso ou .cue original."
     }
    }
   }
  },
  "A quieter Game Mode home with one row of covers. To go back to the native home, remove the plugin below.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma home mais calma para o Game Mode, com uma linha de capas. Para voltar à home nativa, remova o plugin abaixo."
     }
    }
   }
  },
  "API key": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Chave de API"
     }
    }
   }
  },
  "API token": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Token de API"
     }
    }
   }
  },
  "About": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Sobre"
     }
    }
   }
  },
  "Access key": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Chave de acesso"
     }
    }
   }
  },
  "Achievements for games on RetroArch and Dolphin, turned on in every game you send. Your password goes only to RetroAchievements; QuietDeck keeps just the sign-in token.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Conquistas para jogos no RetroArch e no Dolphin, ligadas em todo jogo que você enviar. Sua senha vai só ao RetroAchievements; o QuietDeck guarda apenas o token de acesso."
     }
    }
   }
  },
  "Achievements off": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Conquistas desligadas"
     }
    }
   }
  },
  "Achievements on": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Conquistas ligadas"
     }
    }
   }
  },
  "Achievements wait until the emulator is closed": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "As conquistas esperam o emulador fechar"
     }
    }
   }
  },
  "Add %@ to Steam?": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicionar %@ ao Steam?"
