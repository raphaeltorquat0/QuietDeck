  },
  "The Deck approved this Mac and is turning on SSH.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "O Deck aprovou este Mac e está ligando o SSH."
     }
    }
   }
  },
  "The Deck refused the login. Pair it again. %@": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "O Deck recusou o login. Pareie de novo. %@"
     }
