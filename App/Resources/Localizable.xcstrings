{
 "sourceLanguage": "en",
 "strings": {
  "%@ already exists.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ já existe."
     }
    }
   }
  },
  "%@ answered %@. Check the API key in Settings.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ respondeu %@. Confira a chave de API em Ajustes."
     }
    }
   }
  },
  "%@ doesn't match any known BIOS hash, so it wasn't copied.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não confere com nenhum hash de BIOS conhecido, então não foi copiado."
     }
    }
   }
  },
  "%@ free": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ livres"
     }
    }
   }
  },
  "%@ is missing and Homebrew isn't installed. Install Homebrew from brew.sh, then try again.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não foi encontrado, e o Homebrew não está instalado. Instale o Homebrew em brew.sh e tente de novo."
     }
    }
   }
  },
  "%@ isn't there anymore. Check that the network share is mounted.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "%@ não está mais lá. Confira se o compartilhamento de rede está montado."
     }
    }
   }
  },
  "%lld updates": {
   "localizations": {
    "en": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld update"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld updates"
        }
       }
      }
     }
    },
    "pt-BR": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld atualização"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%lld atualizações"
        }
       }
      }
     }
    }
   }
  },
  "A config file already exists. Only the ROM, BIOS and save paths change, and a backup is kept next to it.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Já existe um arquivo de configuração. Só os caminhos de ROM, BIOS e saves mudam, e um backup fica ao lado dele."
     }
    }
   }
  },
  "A pairing request from this Mac is on the Deck's screen. Choose **Approve**.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Há um pedido de pareamento deste Mac na tela do Deck. Escolha **Aprovar**."
     }
    }
   }
  },
  "API key": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Chave de API"
     }
    }
   }
  },
  "About": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Sobre"
     }
    }
   }
  },
