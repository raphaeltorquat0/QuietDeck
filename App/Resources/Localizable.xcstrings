  },
  "Add to Steam": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicionar ao Steam"
     }
    }
   }
  },
  "Add to Steam after sending?": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicionar ao Steam depois de enviar?"
