  "Already on the Deck": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Já está no Deck"
     }
    }
   }
  },
  "Any game running on the Deck will close and unsaved progress will be lost.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "O jogo aberto no Deck vai fechar, e o progresso não salvo será perdido."
     }
    }
   }
  },
  "Applied after the next reboot": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Vale depois do próximo reinício"
     }
    }
   }
  },
  "Apply %lld": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplicar %lld"
     }
    }
   }
  },
  "Apply Again": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplicar de novo"
     }
    }
   }
  },
  "Apply Quiet Glass": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplicar Quiet Glass"
     }
    }
   }
  },
  "Apply Quiet Theme": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplicar Tema Quiet"
     }
    }
   }
  },
  "Applying artwork doesn't close anything. Steam shows it the next time the library reloads.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplicar artes não fecha nada. O Steam as mostra na próxima vez que a biblioteca recarregar."
     }
    }
   }
  },
  "Applying patch": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplicando o patch"
     }
    }
   }
  },
  "Approve": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprovar"
     }
    }
   }
  },
  "Approve on the Deck": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprove no Deck"
     }
    }
   }
  },
  "Archives are extracted when the emulator can't read them, CD and DVD images become CHD on supported systems, and multi-disc games get an .m3u. Your original files aren't changed.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Arquivos compactados são extraídos quando o emulador não os lê, imagens de CD e DVD viram CHD nos sistemas compatíveis, e jogos com vários discos ganham um .m3u. Seus arquivos originais não são alterados."
     }
    }
   }
  },
  "Artwork": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Artes"
     }
    }
   }
  },
