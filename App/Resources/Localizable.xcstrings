     "stringUnit": {
      "state": "translated",
      "value": "Desenvolvedor"
     }
    }
   }
  },
  "Developer Mode exposes Steam's debug port on your local network. Turn it off in Settings if you don't trust this network.": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "O Modo de Desenvolvedor expõe a porta de debug do Steam na sua rede local. Desligue-o nas configurações se não confiar nesta rede."
     }
    }
   }
  },
  "Discharging": {
   "localizations": {
    "pt-BR": {
     "stringUnit": {
      "state": "translated",
      "value": "Descarregando"
     }
    }
   }
  },
